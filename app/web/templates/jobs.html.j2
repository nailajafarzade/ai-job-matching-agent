{% extends "base.html.j2" %}
{% block title %}Jobs · Job Agent{% endblock %}
{% block content %}
<h2>Jobs</h2>
<form class="filters" method="get" action="/ui">
    <label>Decision
        <select name="decision">
            <option value="">All</option>
            {% for item in decisions %}<option value="{{ item.value }}" {% if decision == item.value %}selected{% endif %}>{{ item.value }}</option>{% endfor %}
        </select>
    </label>
    <label>Application status
        <select name="status">
            <option value="">All</option>
            {% for item in statuses %}<option value="{{ item.value }}" {% if status == item.value %}selected{% endif %}>{{ item.value }}</option>{% endfor %}
        </select>
    </label>
    <button type="submit">Filter</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Title</th><th>Company</th><th>Source</th><th>Decision</th><th>Final score</th><th>Application</th></tr></thead>
    <tbody>
    {% for row in rows %}
        <tr>
            <td><a href="/ui/jobs/{{ row.job.id }}">{{ row.job.title }}</a></td>
            <td>{{ row.job.company }}</td>
            <td>{{ row.job.source }}</td>
            <td>{{ row.match.decision if row.match else "—" }}</td>
            <td>{% if row.match and row.match.final_score is not none %}{{ "%.1f"|format(row.match.final_score) }}{% else %}—{% endif %}</td>
            <td>{{ row.application.status if row.application else "—" }}</td>
        </tr>
    {% else %}
        <tr><td colspan="6">No jobs found.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
