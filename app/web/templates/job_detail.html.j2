{% extends "base.html.j2" %}
{% block title %}{{ job.title }} · Job Agent{% endblock %}
{% block content %}
<p><a href="/ui">← All jobs</a></p>
{% if message %}<p class="notice">{{ message }}</p>{% endif %}
{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
<h2>{{ job.title }}</h2>
<p><strong>Company:</strong> {{ job.company }} · <strong>Source:</strong> {{ job.source }}</p>
{% if job.url %}<p><strong>Original post:</strong> <a href="{{ job.url }}" target="_blank" rel="noopener noreferrer">{{ job.url }}</a></p>{% endif %}
<p><strong>Location:</strong> {{ job.location or job.location_restrictions or "Not stated" }}</p>
<p><strong>Remote eligibility:</strong> {{ job.remote_work_eligibility }}</p>
<section>
    <h3>Match</h3>
    {% if match %}
        <p><strong>Decision:</strong> {{ match.decision }} · <strong>Final score:</strong> {% if match.final_score is not none %}{{ "%.1f"|format(match.final_score) }}{% else %}—{% endif %}</p>
        <table class="compact"><thead><tr><th>Skill</th><th>Semantic</th><th>Title</th></tr></thead>
            <tbody><tr><td>{{ match.skill_score if match.skill_score is not none else "—" }}</td><td>{{ match.semantic_score if match.semantic_score is not none else "—" }}</td><td>{{ match.title_score if match.title_score is not none else "—" }}</td></tr></tbody>
        </table>
        <h4>Explanation</h4><p class="preformatted">{{ match.explanation }}</p>
        {% if match.review_reasons %}<h4>Review reasons</h4><ul>{% for reason in match.review_reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% endif %}
        {% if match.reject_reasons %}<h4>Rejection reasons</h4><ul>{% for reason in match.reject_reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% endif %}
        <div class="columns">
            <section><h4>Matched skills</h4>{% if match.matched_skills %}<ul>{% for skill in match.matched_skills %}<li>{{ skill }}</li>{% endfor %}</ul>{% else %}<p>None</p>{% endif %}</section>
            <section><h4>Studied skills</h4>{% if match.studied_skills %}<ul>{% for skill in match.studied_skills %}<li>{{ skill }}</li>{% endfor %}</ul>{% else %}<p>None</p>{% endif %}</section>
            <section><h4>Missing skills</h4>{% if match.missing_skills %}<ul>{% for skill in match.missing_skills %}<li>{{ skill }}</li>{% endfor %}</ul>{% else %}<p>None</p>{% endif %}</section>
        </div>
    {% else %}<p>No match result is available.</p>{% endif %}
</section>
<section>
    <h3>Application</h3>
    {% if application %}
        <p><strong>Status:</strong> {{ application.status }}</p>
        <p><strong>Selected CV:</strong> {{ cv_entry.id if cv_entry else application.cv_id or "None" }}{% if cv_entry %} — {{ cv_entry.file }}{% endif %}</p>
        {% if cv_reason %}<p><strong>CV choice reason:</strong> {{ cv_reason }}</p>{% endif %}
        {% if application.letter_text %}<h4>Cover letter</h4><p class="letter">{{ application.letter_text }}</p>{% endif %}
        <h4>Reviewer issues</h4>
        {% if application.review_issues %}<ul>{% for issue in application.review_issues %}<li class="{{ issue.level }}"><strong>{{ issue.level }}:</strong> {{ issue.message }}</li>{% endfor %}</ul>{% else %}<p>No issues.</p>{% endif %}
        <h4>Status history</h4>
        {% if application.events %}<ol class="events">{% for event in application.events %}<li>{{ event.created_at }} — {{ event.from_status or "new" }} → {{ event.to_status }}{% if event.note %}: {{ event.note }}{% endif %}</li>{% endfor %}</ol>{% else %}<p>No events recorded.</p>{% endif %}
    {% else %}<p>No application prepared yet.</p>{% endif %}
</section>
<section class="actions">
    <h3>Actions</h3>
    {% if not application or application.status == "prepared" %}
    <form method="post" action="/ui/jobs/{{ job.id }}/prepare"><button type="submit">Prepare application</button></form>
    {% endif %}
    {% if application and application.status == "prepared" %}
    <form method="post" action="/ui/applications/{{ application.id }}/approve">
        {% if match and match.decision == "needs_review" %}<label class="checkbox"><input type="checkbox" name="eligibility_checked" value="true"> I checked the eligibility</label>{% endif %}
        <label>Note <input type="text" name="note"></label>
        <button type="submit">Approve</button>
    </form>
    {% endif %}
    {% if application and application.status in ["prepared", "approved", "package_ready"] %}
    <form method="post" action="/ui/applications/{{ application.id }}/skip">
        <label>Note <input type="text" name="note"></label>
        <button type="submit">Skip</button>
    </form>
    {% endif %}
    {% if application and allowed_statuses %}
    <form method="post" action="/ui/applications/{{ application.id }}/status">
        <label>Change status
            <select name="status">{% for target in allowed_statuses %}<option value="{{ target }}">{{ target }}</option>{% endfor %}</select>
        </label>
        <label>Note <input type="text" name="note"></label>
        <button type="submit">Update status</button>
    </form>
    {% endif %}
</section>
<details><summary>Original job description</summary><p class="preformatted">{{ job.description_raw }}</p></details>
{% endblock %}
